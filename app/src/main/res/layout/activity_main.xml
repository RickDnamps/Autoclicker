<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Service status -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <LinearLayout
                    android:id="@+id/enableGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/enableButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/enable_service" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/restricted_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/appInfoButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_app_info" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="@string/show_panel"
            android:textSize="16sp" />

        <!-- Speed -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_speed" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/interval_ms">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/intervalInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="7" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/press_ms">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pressInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/speedEstimate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/randomIntervalSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/random_interval" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/randomIntervalLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/random_interval_ms">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/randomIntervalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/randomOffsetSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/random_offset" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/randomOffsetLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/random_offset_px">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/randomOffsetInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Multi-point -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_multi" />

        <RadioGroup
            android:id="@+id/multiGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/multiSequential"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/multi_sequential" />

            <RadioButton
                android:id="@+id/multiSimultaneous"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/multi_simultaneous" />
        </RadioGroup>

        <!-- Stop condition -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_stop" />

        <RadioGroup
            android:id="@+id/stopGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/stopNever"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stop_never" />

            <RadioButton
                android:id="@+id/stopCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stop_count" />

            <RadioButton
                android:id="@+id/stopTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stop_time" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/stopValueLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/stopValueInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="9" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Look -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_look" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/target_size"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/targetSizeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:valueFrom="32"
            android:valueTo="120"
            app:labelBehavior="floating" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_size"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/panelSizeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="60"
            android:valueTo="160"
            app:labelBehavior="floating" />

        <!-- Help -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_help" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/help_text"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
</ScrollView>
